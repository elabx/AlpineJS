<?php
namespace ProcessWire;

class AlpineJS extends WireData implements Module
{

    /**
     * Module information
     */
    public static function getModuleInfo()
    {
        return [
            'title' => 'AlpineJS',
            'summary' => 'Integrates Alpine.js locally into ProcessWire Admin with 1-click updates.',
            'version' => '006',
            'author' => 'elabx',
            'href' => 'https://github.com/elabx/AlpineJS',
            'autoload' => true,
            'singular' => true,
        ];
    }

    /**
     * List of official AlpineJS plugins with their CDN filenames
     */
    protected static $pluginsList = [
        'mask' => 'cdn.min.js', // @alpinejs/mask
        'intersect' => 'cdn.min.js',
        'persist' => 'cdn.min.js',
        'focus' => 'cdn.min.js',
        'collapse' => 'cdn.min.js',
        'morph' => 'cdn.min.js',
        'history' => 'cdn.min.js',
    ];

    /**
     * Path to the JS storage directory inside the module
     */
    protected function getJsPath()
    {
        return $this->wire('config')->paths->AlpineJS . 'js/';
    }

    /**
     * URL to the JS storage directory
     */
    protected function getJsUrl()
    {
        return $this->wire('config')->urls->AlpineJS . 'js/';
    }

    /**
     * Ready method to attach hooks
     */
    public function ready()
    {
        if ($this->wire('page')->template->name === 'admin') {
            $this->addScriptsToAdmin();
        }
    }

    /**
     * Add scripts to ProcessWire Admin
     *
     * Uses deferred script tags in <head> so that Alpine initializes AFTER
     * all body scripts (e.g. Inputfield JS) have registered their
     * alpine:init listeners.
     */
    protected function addScriptsToAdmin()
    {
        $tags = '';
        $v = $this->installedVersion;

        // 1. Plugin scripts first (must load before core)
        if (is_array($this->activePlugins)) {
            foreach ($this->activePlugins as $plugin) {
                $file = "alpine-{$plugin}.min.js";
                if (file_exists($this->getJsPath() . $file)) {
                    $url = $this->getJsUrl() . $file . "?v=" . $v;
                    $tags .= "<script defer src='{$url}'></script>\n";
                }
            }
        }

        // 2. Core AlpineJS
        $tags .= "<script defer src='{$this->getCoreScriptUrl()}'></script>\n";

        // Inject as <script defer> in <head>. Deferred head scripts execute
        // after all synchronous body scripts, guaranteeing that alpine:init
        // listeners are already registered when Alpine starts.
        $this->wire()->adminTheme->addExtraMarkup('head', $tags);
    }

    /**
     * Returns the URL to the core Alpine.js script.
     * Hookable — override this to load Alpine.js from a custom location.
     *
     * @return string
     */
    public function ___getCoreScriptUrl()
    {
        if ($this->custom_file) {
            return $this->wire('config')->urls->root . ltrim($this->custom_file, '/');
        }

        return $this->getJsUrl() . "alpine.min.js?v=" . $this->installedVersion;
    }

    /**
     * Fetch latest version from registry
     */
    public static function getRemoteVersion()
    {
        $http = new WireHttp();
        $json = $http->get('https://registry.npmjs.org/alpinejs/latest');
        if ($json) {
            $data = json_decode($json, true);
            return $data['version'] ?? null;
        }
        return null;
    }

    /**
     * Download all files locally
     */
    public function downloadAlpineFiles($version)
    {
        $path = $this->getJsPath();
        if (!is_dir($path)) {
            if (!mkdir($path, 0755, true)) {
                $this->error("Could not create directory: $path");
                return false;
            }
        }

        $http = new WireHttp();
        $successCount = 0;

        // 1. Download Core
        $coreUrl = "https://unpkg.com/alpinejs@{$version}/dist/cdn.min.js";
        $coreDest = $path . "alpine.min.js";
        $coreData = $http->get($coreUrl);

        if ($coreData) {
            if (file_put_contents($coreDest, $coreData))
                $successCount++;
        } else {
            $this->error("Failed to download Core: $coreUrl");
        }

        // 2. Download ALL Plugins (so they are ready if enabled later)
        foreach (self::$pluginsList as $name => $filename) {
            $url = "https://unpkg.com/@alpinejs/{$name}@{$version}/dist/{$filename}";
            $dest = $path . "alpine-{$name}.min.js";
            $data = $http->get($url);

            if ($data) {
                if (file_put_contents($dest, $data))
                    $successCount++;
            } else {
                $this->warning("Failed to download Plugin: $name");
            }
        }

        return $successCount > 0;
    }

    /**
     * Returns the HTML script tags for manual inclusion in templates
     */
    public function renderScripts(array $plugins = [])
    {
        $out = '';

        // 1. Load Plugins first
        $v = $this->installedVersion;
        foreach ($plugins as $plugin) {
            $file = "alpine-{$plugin}.min.js";
            if (file_exists($this->getJsPath() . $file)) {
                $url = $this->getJsUrl() . $file . "?v=" . $v;
                $out .= "<script defer src='{$url}'></script>\n";
            }
        }

        // 2. Load Core AlpineJS
        $url = $this->getCoreScriptUrl();
        $out .= "<script defer src='{$url}'></script>\n";

        return $out;
    }

    /**
     * Uninstall the module and remove downloaded files
     */
    public function ___uninstall()
    {
        $path = $this->getJsPath();
        if (is_dir($path)) {
            $this->wire('files')->rmdir($path, true);
            $this->message("Removed AlpineJS files located in $path");
        }
    }
}